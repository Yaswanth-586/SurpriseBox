# SurpriseBox Frontend Environment Variables

# The URL of the FastAPI backend. 
# For local development, this is typically http://localhost:8000
# For production (Vercel), this should point to your Render backend URL (e.g. https://surprisebox-api.onrender.com)
VITE_API_URL=https://surprisebox-api.onrender.com

# Google OAuth Client ID (Required for "Continue with Google" to work)
# Get this from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
