# SurpriseBox Backend Environment Variables

# Environment specific configuration
PROJECT_NAME="SurpriseBox API"

# Security
# Generate a strong secret key for production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your-secret-key-change-in-production

# CORS
# The URL of your frontend (e.g., http://localhost:5173 for local, or https://your-vercel-app.vercel.app for production)
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database
# For local SQLite: sqlite:///./surprisebox.db
# For production Supabase Postgres: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./surprisebox.db

# Supabase Storage (Optional for local dev, required for production if not using local disk)
# Find these in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Use the `service_role` secret key to bypass Row Level Security for server-side uploads/signed URLs.
# NEVER expose this key to the frontend!
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=surprises
